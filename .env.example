# Supabase 프로젝트 설정
# https://supabase.com/dashboard → 프로젝트 → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# ──────────────────────────────────────────
# Vercel 배포 시 환경변수 설정 방법:
# 1. https://vercel.com → 프로젝트 → Settings → Environment Variables
# 2. 위 변수 3개를 Production / Preview / Development 모두 추가
# 3. NEXT_PUBLIC_* 는 클라이언트에서도 사용되므로 반드시 등록
# 4. SUPABASE_SECRET_KEY 는 서버 API에서만 사용 (민감정보)
# ──────────────────────────────────────────